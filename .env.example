# VertAIx Environment Configuration Template
DATABASE_URL=postgresql://postgres:password@localhost:5432/vertaix_db
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
FLASK_ENV=development
GROQ_API_KEY=your_groq_api_key_here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Service Configuration (Optional in development - logs to console fallback)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=password
EMAIL_FROM=no-reply@vertaix.local
FRONTEND_BASE_URL=http://localhost:3000

